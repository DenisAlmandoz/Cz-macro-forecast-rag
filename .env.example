# Copy to .env and fill in. Never commit the real .env.
# GROK_API_KEY is required for /chat to generate answers; without it every
# query returns used_llm=false with an explanatory error.
GROK_API_KEY=
GROK_API_URL=https://api.groq.com/openai/v1/chat/completions
GROK_MODEL=openai/gpt-oss-120b

# Optional tuning
# EMBEDDING_MODEL=all-MiniLM-L6-v2
# DOCUMENTS_DIR=.                 # directory scanned for PDFs at startup
# VECTOR_STORE_DIR=./data/chroma
# RAG_LAMBDA=0.5                  # weight of dense vs BM25 scores
# RAG_DENSE_MULTIPLIER=4          # dense candidate pool = top_k x this
# CHUNK_SIZE=1000
# CHUNK_OVERLAP=200
# MAX_CONTEXT_CHARS=12000
# GROK_TIMEOUT=60
# LOG_LEVEL=INFO